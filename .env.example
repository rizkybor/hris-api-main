APP_NAME=HRIS+
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=8

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hris_api
DB_USERNAME=admin
DB_PASSWORD=secret123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CACHE_STORE=redis
CACHE_PREFIX=hris_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=null
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey123

FORWARD_PHPMYADMIN_PORT=8080

# Credentials used by database/seeders/SuperAdminSeeder.php, ManagerSeeder.php,
# HrSeeder.php, FinanceSeeder.php to create the initial demo accounts for
# each role. Set real values in your local .env — never commit real
# credentials here. The Super Admin email is fixed to
# User::PROTECTED_EMAIL (superadmin@jcdigital.co.id) and cannot be renamed
# via env — only its name/password are configurable.
SEED_SUPERADMIN_NAME="Super Admin"
SEED_SUPERADMIN_PASSWORD=password

SEED_MANAGER_NAME="Rizky Aji Kurniawan"
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=password

SEED_HR_NAME="Aldi Pratama Putra"
SEED_HR_EMAIL=hr@example.com
SEED_HR_PASSWORD=password

SEED_FINANCE_NAME="Andy Saputra"
SEED_FINANCE_EMAIL=finance@example.com
SEED_FINANCE_PASSWORD=password

# Employee code format: [COUNTRY]JCD[YEAR]-[COMPANY ID][EMPLOYMENT TYPE][5-DIGIT ID]-[CHECK DIGIT]
EMPLOYEE_CODE_COUNTRY=ID
EMPLOYEE_CODE_GROUP_PREFIX=JCD
EMPLOYEE_CODE_COMPANY_ID=001
